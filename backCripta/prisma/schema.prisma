generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MEMBER
  ADMIN
}

enum Rarity {
  COMUN
  RARA
  EPICA
  LEGENDARIA
}

enum EstadoReservaMesa {
  PENDIENTE
  CONFIRMADA
  CANCELADA
  COMPLETADA
}

model User {
  id             String  @id @default(uuid())
  dni            String? @unique
  name           String
  email          String  @unique
  password       String
  role           Role    @default(MEMBER)
  lastRenewal    String?
  expirationDate String?
  status         String  @default("Pendiente")
  avatar         String?

  resetToken     String?
  resetTokenExpires DateTime?

  coins          Int      @default(100)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  reservas        ReservaMesa[]
  packs           Pack[]
  userCards       UserCard[]
  coinTransactions CoinTransaction[]
}

model Collection {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cards       Card[]
}

model PackConfig {
  id           Int      @id @default(autoincrement())
  price        Int      @default(100)
  cardsPerPack Int      @default(2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Card {
  id           Int         @id @default(autoincrement())
  name         String
  rarity       Rarity
  dropWeight   Int
  imageUrl     String?
  collectionId Int?
  createdAt    DateTime    @default(now())

  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  packCards    PackCard[]
  userCards    UserCard[]
}

model Pack {
  id        Int       @id @default(autoincrement())
  userId    String
  openedAt  DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards     PackCard[]
}

model PackCard {
  id     Int  @id @default(autoincrement())
  packId Int
  cardId Int

  pack   Pack @relation(fields: [packId], references: [id], onDelete: Cascade)
  card   Card @relation(fields: [cardId], references: [id])
}

model UserCard {
  id       Int    @id @default(autoincrement())
  userId   String
  cardId   Int
  quantity Int    @default(1)

  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  card     Card   @relation(fields: [cardId], references: [id])

  @@unique([userId, cardId])
}

model CoinTransaction {
  id        Int      @id @default(autoincrement())
  userId    String
  amount    Int
  reason    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Mesa {
  id       String  @id @default(uuid())
  asientos Int
  orden    Int     @unique
  esDePago Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservas ReservaMesa[]
}

model ReservaMesa {
  id                 String            @id @default(uuid())
  mesaId             String
  userId             String
  fechaHoraInicio    DateTime
  fechaHoraFin       DateTime
  asientosReservados Int
  precio             Decimal           @default(0) @db.Decimal(10, 2)
  estado             EstadoReservaMesa @default(PENDIENTE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mesa Mesa @relation(fields: [mesaId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([mesaId, fechaHoraInicio, fechaHoraFin])
  @@index([userId, fechaHoraInicio])
  @@index([estado])
}
